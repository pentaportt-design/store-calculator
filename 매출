<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #0f0f0f;
    --surface: #181818;
    --surface2: #222222;
    --border: rgba(255,255,255,0.08);
    --border2: rgba(255,255,255,0.14);
    --text: #f0f0f0;
    --text2: #888;
    --text3: #555;
    --green: #4ade80;
    --red: #f87171;
    --blue: #60a5fa;
  }
  html { font-size: 14px; }
  body { background: var(--bg); color: var(--text); font-family: 'Noto Sans KR', sans-serif; min-height: 100vh; line-height: 1.6; }
 
  header { border-bottom: 1px solid var(--border); padding: 20px 32px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; background: rgba(15,15,15,0.92); backdrop-filter: blur(12px); z-index: 100; }
  .logo { font-size: 16px; font-weight: 700; letter-spacing: -0.3px; display: flex; align-items: center; gap: 10px; }
  .logo-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
  .header-date { font-size: 12px; color: var(--text3); font-family: 'DM Mono', monospace; }
 
  main { max-width: 980px; margin: 0 auto; padding: 32px 24px 64px; }
 
  .summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 40px; }
  .summary-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; position: relative; overflow: hidden; }
  .summary-card::before { content:''; position:absolute; top:0;left:0;right:0; height:2px; }
  .summary-card.green::before { background: var(--green); }
  .summary-card.red::before { background: var(--red); }
  .summary-card.blue::before { background: var(--blue); }
  .summary-label { font-size: 11px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; font-family: 'DM Mono', monospace; }
  .summary-value { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; font-family: 'DM Mono', monospace; }
  .summary-value.green { color: var(--green); }
  .summary-value.red { color: var(--red); }
 
  .section { margin-bottom: 40px; }
  .section-title { font-size: 13px; font-weight: 500; color: var(--text2); text-transform: uppercase; letter-spacing: 0.6px; font-family: 'DM Mono', monospace; margin-bottom: 16px; }
  .chart-box { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
  .chart-wrap { position: relative; width: 100%; }
  .legend { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text2); }
  .legend-dot { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
  .bar-list { display: flex; flex-direction: column; gap: 10px; }
  .bar-item-label { font-size: 12px; color: var(--text2); margin-bottom: 4px; display: flex; justify-content: space-between; }
  .bar-track { background: var(--surface2); border-radius: 3px; height: 6px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 3px; transition: width 0.5s ease; }
  .bar-sub { font-size: 11px; color: var(--text3); margin-top: 3px; font-family: 'DM Mono', monospace; }
 
  .tab-row { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }
  .tab-btn { background: transparent; border: 1px solid var(--border2); border-radius: 6px; padding: 5px 14px; font-size: 12px; cursor: pointer; color: var(--text2); font-family: 'Noto Sans KR', sans-serif; transition: all 0.15s; }
  .tab-btn:hover { border-color: rgba(255,255,255,0.25); color: var(--text); }
  .tab-btn.active { background: rgba(96,165,250,0.15); border-color: rgba(96,165,250,0.4); color: var(--blue); }
 
  .divider { border: none; border-top: 1px solid var(--border); margin: 40px 0; }
 
  .input-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
  .input-panel-title { font-size: 14px; font-weight: 500; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
  .input-panel-title .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
  .form-field label { display: block; font-size: 11px; color: var(--text3); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; font-family: 'DM Mono', monospace; }
  .form-field input, .form-field select { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: 7px; padding: 9px 12px; font-size: 13px; color: var(--text); font-family: 'Noto Sans KR', sans-serif; outline: none; transition: border-color 0.15s; }
  .form-field input:focus, .form-field select:focus { border-color: rgba(96,165,250,0.5); }
  .form-field select option { background: #222; }
  .submit-btn { width: 100%; padding: 11px; background: rgba(96,165,250,0.1); border: 1px solid rgba(96,165,250,0.3); border-radius: 8px; color: var(--blue); font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'Noto Sans KR', sans-serif; transition: all 0.15s; margin-top: 4px; }
  .submit-btn:hover { background: rgba(96,165,250,0.2); }
  .submit-btn:active { transform: scale(0.99); }
  .msg { font-size: 12px; min-height: 18px; margin-top: 8px; font-family: 'DM Mono', monospace; }
 
  .data-table-wrap { margin-top: 16px; max-height: 280px; overflow-y: auto; border: 1px solid var(--border); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  thead th { background: var(--surface2); padding: 9px 12px; text-align: left; color: var(--text3); font-weight: 500; position: sticky; top: 0; font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.4px; }
  tbody td { padding: 8px 12px; border-top: 1px solid var(--border); color: var(--text2); vertical-align: middle; }
  tbody tr:hover td { background: rgba(255,255,255,0.02); }
  .del-btn { background: none; border: none; color: var(--text3); cursor: pointer; font-size: 15px; padding: 2px 6px; border-radius: 4px; transition: all 0.1s; }
  .del-btn:hover { color: var(--red); background: rgba(248,113,113,0.12); }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; white-space: nowrap; }
 
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }
 
