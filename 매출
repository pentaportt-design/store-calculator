function makeDoughnut(canvasId, labels, data, colors){
  const total=data.reduce((s,v)=>s+v,0);
  return new Chart(document.getElementById(canvasId),{
    type:'doughnut',
    plugins:[ChartDataLabels],
    data:{labels,datasets:[{data,backgroundColor:colors,borderWidth:0,hoverOffset:4}]},
    options:{
      responsive:true,maintainAspectRatio:false,cutout:'55%',
      plugins:{
        legend:{display:false},
        tooltip:{callbacks:{label:ctx=>ctx.raw.toLocaleString()+'원'},backgroundColor:'#222',titleColor:'#aaa',bodyColor:'#f0f0f0',borderColor:'rgba(255,255,255,0.08)',borderWidth:1},
        datalabels:{
          color:'#fff',
          font:{size:10,weight:'500'},
          formatter:(value,ctx)=>{
            const total=ctx.dataset.data.reduce((s,v)=>s+v,0);
            const pct=total>0?Math.round(value/total*100):0;
            if(pct<5) return '';
            const label=ctx.chart.data.labels[ctx.dataIndex];
            return label+' '+pct+'%\n'+value.toLocaleString()+'원';
          },
          textAlign:'center',
          display:(ctx)=>{
            const total=ctx.dataset.data.reduce((s,v)=>s+v,0);
            const pct=ctx.dataset.data[ctx.dataIndex]/total*100;
            return pct>=5;
          }
        }
      }
    }
  });
}
 
let state=loadData();
let itemTab='donut';
let revenueChartInst,itemChartInst,brandChartInst;
 
function fmt(n){ return Math.round(n).toLocaleString()+'원'; }
function today(){ const d=new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
 
document.getElementById('today-date').textContent=new Date().toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric',weekday:'short'});
 
function renderSummary(){
  const totalRev=state.revenues.reduce((s,r)=>s+r.amount,0);
  const totalExp=state.expenses.reduce((s,e)=>s+e.amount,0);
  const profit=totalRev-totalExp;
  document.getElementById('summary-grid').innerHTML=`
    <div class="summary-card green"><div class="summary-label">총 매출 입금</div><div class="summary-value green">${fmt(totalRev)}</div></div>
    <div class="summary-card red"><div class="summary-label">총 지출</div><div class="summary-value red">${fmt(totalExp)}</div></div>
    <div class="summary-card blue"><div class="summary-label">순이익 (추정)</div><div class="summary-value ${profit>=0?'green':'red'}">${fmt(profit)}</div></div>
  `;
}
 
function renderRevenueChart(){
  const sorted=[...state.revenues].sort((a,b)=>a.date.localeCompare(b.date));
  if(revenueChartInst) revenueChartInst.destroy();
  revenueChartInst=new Chart(document.getElementById('revenueChart'),{
    type:'line',
    data:{labels:sorted.map(r=>r.date.slice(5).replace('-','/')),datasets:[{label:'매출',data:sorted.map(r=>r.amount),borderColor:'#60a5fa',backgroundColor:'rgba(96,165,250,0.07)',borderWidth:2,pointBackgroundColor:'#60a5fa',pointRadius:4,pointHoverRadius:6,fill:true,tension:0.3}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>ctx.raw.toLocaleString()+'원'},backgroundColor:'#222',titleColor:'#aaa',bodyColor:'#f0f0f0',borderColor:'rgba(255,255,255,0.08)',borderWidth:1}},scales:{x:{ticks:{color:'#555',font:{size:11},autoSkip:false},grid:{color:'rgba(255,255,255,0.04)'}},y:{ticks:{color:'#555',font:{size:11},callback:v=>(v/10000).toFixed(0)+'만'},grid:{color:'rgba(255,255,255,0.04)'}}}}
  });
}
 
function getItemTotals(){
  const map={};
  state.expenses.filter(e=>e.brand==='팔감댁').forEach(e=>{map[e.item]=(map[e.item]||0)+e.amount;});
  return Object.entries(map).sort((a,b)=>b[1]-a[1]);
}
 
function renderItemChart(){
  const entries=getItemTotals();
  const labels=entries.map(e=>e[0]);
  const data=entries.map(e=>e[1]);
  const total=data.reduce((s,v)=>s+v,0);
  const colors=labels.map((_,i)=>ITEM_COLORS[i%ITEM_COLORS.length]);
  document.getElementById('item-legend').innerHTML=labels.map((l,i)=>`<span class="legend-item"><span class="legend-dot" style="background:${colors[i]};"></span>${l}</span>`).join('');
  document.getElementById('item-bar-list').innerHTML=entries.map((e,i)=>{
    const pct=total>0?Math.round(e[1]/total*100):0;
    return `<div><div class="bar-item-label"><span>${e[0]}</span><span style="font-family:'DM Mono',monospace;">${pct}%</span></div><div class="bar-track"><div class="bar-fill" style="background:${colors[i]};width:${pct}%;"></div></div><div class="bar-sub">${fmt(e[1])}</div></div>`;
  }).join('');
  if(itemChartInst) itemChartInst.destroy();
  if(itemTab==='donut'){
    itemChartInst=makeDoughnut('itemChart',labels,data,colors);
  } else {
    itemChartInst=new Chart(document.getElementById('itemChart'),{type:'bar',data:{labels,datasets:[{data,backgroundColor:colors,borderRadius:5,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>ctx.raw.toLocaleString()+'원'},backgroundColor:'#222',titleColor:'#aaa',bodyColor:'#f0f0f0',borderColor:'rgba(255,255,255,0.08)',borderWidth:1}},scales:{x:{ticks:{color:'#555',font:{size:10}},grid:{color:'rgba(255,255,255,0.04)'}},y:{ticks:{color:'#555',font:{size:11},callback:v=>(v/10000).toFixed(0)+'만'},grid:{color:'rgba(255,255,255,0.04)'}}}}});
  }
}
 
function renderBrandChart(){
  const ddangTotal=state.expenses.filter(e=>e.brand==='팔감댁').reduce((s,e)=>s+e.amount,0);
  const personalTotal=state.expenses.filter(e=>e.brand==='개인지출').reduce((s,e)=>s+e.amount,0);
  const govTotal=state.expenses.filter(e=>e.brand==='공과금').reduce((s,e)=>s+e.amount,0);
 
  const labels=['팔감댁','개인지출','공과금'];
  const data=[ddangTotal,personalTotal,govTotal];
  const colors=['#fb923c','#a78bfa','#f87171'];
  const total=data.reduce((s,v)=>s+v,0);
 
  document.getElementById('brand-legend').innerHTML=labels.map((l,i)=>`<span class="legend-item"><span class="legend-dot" style="background:${colors[i]};"></span>${l} <span style="font-family:'DM Mono',monospace;color:var(--text3);">${fmt(data[i])}</span></span>`).join('');
  document.getElementById('brand-bar-list').innerHTML=labels.map((l,i)=>{
    const pct=total>0?Math.round(data[i]/total*100):0;
    return `<div><div class="bar-item-label"><span>${l}</span><span style="font-family:'DM Mono',monospace;">${pct}% · ${fmt(data[i])}</span></div><div class="bar-track"><div class="bar-fill" style="background:${colors[i]};width:${pct}%;"></div></div></div>`;
  }).join('');
 
  if(brandChartInst) brandChartInst.destroy();
  brandChartInst=makeDoughnut('brandChart',labels,data,colors);
 
  renderPersonalBreakdown();
  renderGovBreakdown();
}
 
let personalChartInst, govChartInst;
 
function renderPersonalBreakdown(){
  const itemMap={};
  state.expenses.filter(e=>e.brand==='개인지출').forEach(e=>{itemMap[e.item]=(itemMap[e.item]||0)+e.amount;});
  const entries=Object.entries(itemMap).sort((a,b)=>b[1]-a[1]);
  const labels=entries.map(([k])=>k);
  const data=entries.map(([,v])=>v);
  const total=data.reduce((s,v)=>s+v,0);
  const colors=labels.map((_,i)=>ITEM_COLORS[i%ITEM_COLORS.length]);
  document.getElementById('personal-legend').innerHTML=labels.map((l,i)=>`<span class="legend-item"><span class="legend-dot" style="background:${colors[i]};"></span>${l} <span style="font-family:'DM Mono',monospace;color:var(--text3);">${fmt(data[i])}</span></span>`).join('');
  document.getElementById('personal-bar-list').innerHTML=entries.map(([item,amount],i)=>{
    const pct=total>0?Math.round(amount/total*100):0;
    return `<div style="margin-bottom:10px;"><div class="bar-item-label"><span>${item}</span><span style="font-family:'DM Mono',monospace;">${pct}% · ${fmt(amount)}</span></div><div class="bar-track"><div class="bar-fill" style="background:${colors[i]};width:${pct}%;"></div></div></div>`;
  }).join('');
  if(personalChartInst) personalChartInst.destroy();
  personalChartInst=makeDoughnut('personalChart',labels,data,colors);
}
 
function renderGovBreakdown(){
  const itemMap={};
  state.expenses.filter(e=>e.brand==='공과금').forEach(e=>{itemMap[e.item]=(itemMap[e.item]||0)+e.amount;});
  const entries=Object.entries(itemMap).sort((a,b)=>b[1]-a[1]);
  const labels=entries.map(([k])=>k);
  const data=entries.map(([,v])=>v);
  const total=data.reduce((s,v)=>s+v,0);
  const colors=labels.map((_,i)=>ITEM_COLORS[i%ITEM_COLORS.length]);
  document.getElementById('gov-legend').innerHTML=labels.map((l,i)=>`<span class="legend-item"><span class="legend-dot" style="background:${colors[i]};"></span>${l} <span style="font-family:'DM Mono',monospace;color:var(--text3);">${fmt(data[i])}</span></span>`).join('');
  document.getElementById('gov-bar-list').innerHTML=entries.map(([item,amount],i)=>{
    const pct=total>0?Math.round(amount/total*100):0;
    return `<div style="margin-bottom:10px;"><div class="bar-item-label"><span>${item}</span><span style="font-family:'DM Mono',monospace;">${pct}% · ${fmt(amount)}</span></div><div class="bar-track"><div class="bar-fill" style="background:${colors[i]};width:${pct}%;"></div></div></div>`;
  }).join('');
  if(govChartInst) govChartInst.destroy();
  govChartInst=makeDoughnut('govChart',labels,data,colors);
}
 
function getBadgeStyle(brand){ const c=BRAND_COLORS[brand]||'#888'; return `background:${c}22;color:${c};`; }
 
function renderRevenueTbody(){
  document.getElementById('revenue-tbody').innerHTML=[...state.revenues].sort((a,b)=>b.date.localeCompare(a.date)).map(r=>`
    <tr><td style="font-family:'DM Mono',monospace;">${r.date}</td><td style="font-family:'DM Mono',monospace;color:var(--green);">${r.amount.toLocaleString()}원</td><td><button class="del-btn" onclick="deleteRevenue(${r.id})">×</button></td></tr>`).join('');
}
 
function renderExpenseTbody(){
  document.getElementById('expense-tbody').innerHTML=[...state.expenses].sort((a,b)=>b.date.localeCompare(a.date)).map(e=>`
    <tr><td style="font-family:'DM Mono',monospace;">${e.date}</td><td><span class="badge" style="${getBadgeStyle(e.brand)}">${e.brand}</span></td><td>${e.item}</td><td style="font-family:'DM Mono',monospace;">${e.amount.toLocaleString()}원</td><td><button class="del-btn" onclick="deleteExpense(${e.id})">×</button></td></tr>`).join('');
}
 
function renderAllTbody(){
  const all=[...state.revenues.map(r=>({...r,type:'revenue'})),...state.expenses.map(e=>({...e,type:'expense'}))].sort((a,b)=>b.date.localeCompare(a.date));
  document.getElementById('all-tbody').innerHTML=all.map(row=>{
    if(row.type==='revenue') return `<tr><td style="font-family:'DM Mono',monospace;">${row.date}</td><td><span class="badge" style="background:rgba(96,165,250,0.12);color:#60a5fa;">매출</span></td><td style="color:var(--text3);">입금</td><td style="font-family:'DM Mono',monospace;color:var(--green);">+${row.amount.toLocaleString()}원</td><td><button class="del-btn" onclick="deleteRevenue(${row.id})">×</button></td></tr>`;
    return `<tr><td style="font-family:'DM Mono',monospace;">${row.date}</td><td><span class="badge" style="${getBadgeStyle(row.brand)}">${row.brand}</span></td><td>${row.item}</td><td style="font-family:'DM Mono',monospace;color:var(--red);">-${row.amount.toLocaleString()}원</td><td><button class="del-btn" onclick="deleteExpense(${row.id})">×</button></td></tr>`;
  }).join('');
}
 
function renderAll(){ renderSummary();renderRevenueChart();renderItemChart();renderBrandChart();renderRevenueTbody();renderExpenseTbody();renderAllTbody(); }
 
function switchItemTab(tab,btn){ itemTab=tab; document.querySelectorAll('#item-tab-row .tab-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); renderItemChart(); }
function switchInputTab(tab,btn){ ['revenue','expense','list'].forEach(t=>{document.getElementById('panel-'+t).style.display=t===tab?'':'none';}); document.querySelectorAll('#input-tab-row .tab-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); if(tab==='list') renderAllTbody(); }
 
function showMsg(id,txt,isErr){ const el=document.getElementById(id); el.style.color=isErr?'#f87171':'#4ade80'; el.textContent=txt; setTimeout(()=>el.textContent='',2500); }
 
function addRevenue(){
  const date=document.getElementById('r-date').value;
  const amount=parseInt(document.getElementById('r-amount').value);
  if(!date) return showMsg('r-msg','날짜를 입력해주세요',true);
  if(!amount||amount<=0) return showMsg('r-msg','금액을 입력해주세요',true);
  state.revenues.push({id:state.nextId++,date,amount});
  saveData();
  document.getElementById('r-date').value='';
  document.getElementById('r-amount').value='';
  showMsg('r-msg','매출이 추가됐어요!');
  renderAll();
}
 
function addExpense(){
  const date=document.getElementById('e-date').value;
  const brand=document.getElementById('e-brand').value;
  const item=document.getElementById('e-item').value.trim();
  const amount=parseInt(document.getElementById('e-amount').value);
  if(!date) return showMsg('e-msg','날짜를 입력해주세요',true);
  if(!item) return showMsg('e-msg','항목명을 입력해주세요',true);
  if(!amount||amount<=0) return showMsg('e-msg','금액을 입력해주세요',true);
  state.expenses.push({id:state.nextId++,date,brand,item,amount});
  saveData();
  document.getElementById('e-date').value='';
  document.getElementById('e-item').value='';
  document.getElementById('e-amount').value='';
  showMsg('e-msg','지출이 추가됐어요!');
  renderAll();
}
 
function deleteRevenue(id){ if(!confirm('이 항목을 삭제할까요?')) return; state.revenues=state.revenues.filter(r=>r.id!==id); saveData(); renderAll(); }
function deleteExpense(id){ if(!confirm('이 항목을 삭제할까요?')) return; state.expenses=state.expenses.filter(e=>e.id!==id); saveData(); renderAll(); }
 
document.getElementById('r-date').value=today();
document.getElementById('e-date').value=today();
renderAll();
</script>
